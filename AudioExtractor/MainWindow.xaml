<Window x:Class="AudioExtractor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cvt="clr-namespace:AudioExtractor.Converters"
        mc:Ignorable="d"
        Title="Audio Extractor &amp; Converter" 
        Height="460" Width="860"
        MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterScreen">


    <Window.Resources>
        <cvt:HumanReadableFileSizeConverter x:Key="FileSizeConverter"/>
        <cvt:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <cvt:BooleanVisibilityConverter x:Key="BooleanVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox Name="InputItemListBox" 
                 Grid.Row="0"
                 ItemsSource="{Binding InputItems}"
                 AllowDrop="True" 
                 Drop="InputItemListBox_Drop"
                 MouseDoubleClick="InputItemListBox_MouseDoubleClick"
                 IsEnabled="{Binding IsConversionInProgress, Converter={StaticResource InverseBooleanConverter}}">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Grid.Row="0" 
                                   Grid.RowSpan="2" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   FontWeight="Bold">
                            <Run Text="{Binding FileExtension}"/>
                        </TextBlock>

                        <TextBlock Grid.Column="1" Grid.Row="0" TextTrimming="CharacterEllipsis">
                            <Run FontFamily="Segoe UI Light" 
                                 FontSize="16"
                                 Text="{Binding FileName}"/>
                        </TextBlock>

                        <TextBlock Grid.Column="1" 
                                   Grid.Row="1" 
                                   FontStyle="Italic"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="Directory:"/>
                            <Run Text="{Binding ContainerDirectory}"/>
                            <Run Text="  Size:"></Run>
                            <Run Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}"/>
                        </TextBlock>

                        <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ErrorMessage}" 
                                       Foreground="DarkRed"
                                       TextTrimming="CharacterEllipsis"/>
                            
                            <!-- Progress Bar (Visible during conversion) -->
                            <Grid Margin="0,4,0,0" Height="20">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Converting">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <ProgressBar Value="{Binding Progress}" Minimum="0" Maximum="100" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Progress, StringFormat={}{0:F0}%}" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center" 
                                           FontSize="10" 
                                           FontWeight="Bold" 
                                           Foreground="Black"/>
                            </Grid>

                            <!-- Play Audio and Open Folder Buttons (Visible when Completed) -->
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                        Visibility="{Binding IsCompleted, Converter={StaticResource BooleanVisibilityConverter}}">
                                <Button Content="Play" 
                                        Padding="6,2"
                                        FontSize="11"
                                        Command="{Binding DataContext.PlayFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                                <Button Content="Open Folder" 
                                        Margin="6,0,0,0"
                                        Padding="6,2"
                                        FontSize="11"
                                        Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Remove from List Button -->
                        <Button Grid.Column="3" Grid.Row="0" Grid.RowSpan="2"
                                Content="✕" 
                                ToolTip="Remove from list"
                                FontFamily="Segoe UI"
                                FontSize="14"
                                FontWeight="Bold"
                                Foreground="DimGray"
                                Background="Transparent"
                                BorderThickness="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="26" Height="26"
                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                CommandParameter="{Binding}"
                                IsEnabled="{Binding DataContext.IsConversionInProgress, RelativeSource={RelativeSource AncestorType=ListBox}, Converter={StaticResource InverseBooleanConverter}}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="0" 
                   Text="Drop files here" 
                   FontFamily="Segoe UI Light"
                   FontSize="36"
                   Foreground="Gray"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   Visibility="{Binding IsInputItemsEmpty, Converter={StaticResource BooleanVisibilityConverter}}"/>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0"
                       Margin="0,0,0,8"
                       IsEnabled="{Binding IsConversionInProgress, Converter={StaticResource InverseBooleanConverter}}"
                       TextTrimming="CharacterEllipsis">
                <Run Text="Target folder:"/>
                <Run Text="{Binding TargetFolderPath}"/>
            </TextBlock>

            <StackPanel Grid.Column="1" Grid.Row="0" 
                        Orientation="Horizontal" 
                        Margin="16,0,8,8"
                        VerticalAlignment="Center"
                        IsEnabled="{Binding IsConversionInProgress, Converter={StaticResource InverseBooleanConverter}}">
                <TextBlock Text="Format:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding SupportedFormats}" 
                          SelectedItem="{Binding SelectedFormat}" 
                          Width="70" Height="22" 
                          VerticalContentAlignment="Center"/>
            </StackPanel>

            <Button Grid.Column="2" Grid.Row="0"
                    Margin="8,0,0,8"
                    MinWidth="90"
                    Content="Browse"
                    Command="{Binding BrowseTargetFolderCommand}"/>

            <TextBlock Grid.Column="0" Grid.Row="1"
                       VerticalAlignment="Center"
                       Text="{Binding StatusMessage}"
                       TextTrimming="CharacterEllipsis"/>

            <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button MinWidth="90"
                        Content="Add Files"
                        Command="{Binding AddFilesCommand}"/>
                <Button Margin="8,0,0,0"
                        MinWidth="90"
                        Content="Clear"
                        Command="{Binding ClearItemsCommand}"/>
                <Button Margin="8,0,0,0"
                        MinWidth="90"
                        Content="Start"
                        Command="{Binding StartConversionCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
