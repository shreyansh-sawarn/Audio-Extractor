<Window x:Class="AudioExtractor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:cvt="clr-namespace:AudioExtractor.Converters"
        mc:Ignorable="d"
        Title="Audio Extractor &amp; Converter" 
        Height="460" Width="860"
        MinHeight="360" MinWidth="560"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <cvt:HumanReadableFileSizeConverter x:Key="FileSizeConverter"/>
        <cvt:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <cvt:BooleanVisibilityConverter x:Key="BooleanVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox Name="InputItemListBox" 
                 Grid.Row="0"
                 ItemsSource="{Binding InputItems}"
                 AllowDrop="True" 
                 Drop="InputItemListBox_Drop"
                 IsEnabled="{Binding IsConversionInProgress, Converter={StaticResource InverseBooleanConverter}}">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" 
                                   Grid.Row="0" 
                                   Grid.RowSpan="2" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center"
                                   FontWeight="Bold">
                            <Run Text="{Binding FileExtension}"/>
                        </TextBlock>

                        <TextBlock Grid.Column="1" Grid.Row="0" TextTrimming="CharacterEllipsis">
                            <Run FontFamily="Segoe UI Light" 
                                 FontSize="16"
                                 Text="{Binding FileName}"/>
                        </TextBlock>

                        <TextBlock Grid.Column="1" 
                                   Grid.Row="1" 
                                   FontStyle="Italic"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="Directory:"/>
                            <Run Text="{Binding ContainerDirectory}"/>
                            <Run Text="  Size:"></Run>
                            <Run Text="{Binding FileSize, Converter={StaticResource FileSizeConverter}}"/>
                        </TextBlock>

                        <StackPanel Grid.Column="2" Grid.Row="0" Grid.RowSpan="2"
                                    VerticalAlignment="Center"
                                    Margin="12,0,0,0">
                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ErrorMessage}" 
                                       Foreground="DarkRed"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="0" 
                   Text="Drop files here" 
                   FontFamily="Segoe UI Light"
                   FontSize="36"
                   Foreground="Gray"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"
                   Visibility="{Binding IsInputItemsEmpty, Converter={StaticResource BooleanVisibilityConverter}}"/>

        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Grid.Row="0"
                       Margin="0,0,0,8"
                       IsEnabled="{Binding IsConversionInProgress, Converter={StaticResource InverseBooleanConverter}}"
                       TextTrimming="CharacterEllipsis">
                <Run Text="Target folder:"/>
                <Run Text="{Binding TargetFolderPath}"/>
            </TextBlock>

            <Button Grid.Column="1" Grid.Row="0"
                    Margin="8,0,0,8"
                    MinWidth="90"
                    Content="Browse"
                    Command="{Binding BrowseTargetFolderCommand}"/>

            <TextBlock Grid.Column="0" Grid.Row="1"
                       VerticalAlignment="Center"
                       Text="{Binding StatusMessage}"
                       TextTrimming="CharacterEllipsis"/>

            <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal">
                <Button MinWidth="90"
                        Content="Clear"
                        Command="{Binding ClearItemsCommand}"/>
                <Button Margin="8,0,0,0"
                        MinWidth="90"
                        Content="Start"
                        Command="{Binding StartConversionCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
